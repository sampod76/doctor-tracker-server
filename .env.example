# 
NODE_ENV=development
PORT=5000
# 
MONGODB_URI=mongodb://localhost:27017/doctorTracker
JWT_SECRET=replace-with-32-char-random-string
# 7 day
JWT_EXPIRES_IN=604800

JWT_REFRESH_SECRET=replace-with-another-32-char-random-string
# 30 day
JWT_REFRESH_EXPIRES_IN=2592000

BCRYPT_SALT_ROUNDS=12
# 
CORS_ORIGIN=http://localhost:3000,http://192.168.0.100:3000
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Logger
LOG_LEVEL=info
# Use the active Ethernet DNS server because Node discovers an unusable loopback resolver.
MONGODB_DNS_SERVERS=192.168.0.1
