# Required: supply your own database URI and separate JWT secrets.
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=

# Optional: uncomment only configured entries; otherwise defaults apply.
# NODE_ENV=
# PORT=
# MONGODB_DNS_SERVERS=
# JWT_EXPIRES_IN=
# JWT_REFRESH_EXPIRES_IN=
# BCRYPT_SALT_ROUNDS=
# CORS_ORIGIN=
# RATE_LIMIT_WINDOW_MS=
# RATE_LIMIT_MAX=
# LOG_LEVEL=

# Optional mail/encryption utilities.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# ENCRYPTION_KEY=
# ENCRYPTION_SECRET=

# Required only when creating/backfilling the seed doctor.
# SEED_DOCTOR_MEDICAL_REGISTRATION_NO=
